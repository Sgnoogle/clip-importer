<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ClipImporter</RootNamespace>
    <AssemblyName>ClipImporter</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Clip Importer</Product>
    <AssemblyTitle>Clip Importer</AssemblyTitle>
    <Company>Sgnoogle</Company>
    <Copyright>MIT License · github.com/Sgnoogle/clip-importer</Copyright>
    <Version>1.3.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <StartupObject>ClipImporter.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Main è in Program (App.xaml.cs): App.xaml è una normale pagina -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Traduzioni condivise con la versione Mac + quelle solo Windows -->
    <EmbeddedResource Include="..\..\Resources\strings.json" LogicalName="strings.json" />
    <EmbeddedResource Include="..\strings.windows.json" LogicalName="strings.windows.json" />
    <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="AppIcon.ico" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
