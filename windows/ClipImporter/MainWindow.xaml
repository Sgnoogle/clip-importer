<Window x:Class="ClipImporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipImporter"
        Title="Clip Importer" Width="1180" Height="760" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <local:InverseVisibilityConverter x:Key="NotVis" />
        <local:NullToVisibilityConverter x:Key="NullVis" />

        <!-- La miniatura di una clip o di una foto -->
        <DataTemplate x:Key="ClipTemplate" DataType="{x:Type local:ClipItem}">
            <Border x:Name="Card" Width="{Binding DataContext.ThumbSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,0,14,14" Padding="6" CornerRadius="11" Background="Transparent"
                    BorderThickness="2.5" BorderBrush="Transparent" ToolTip="{Binding Tooltip}"
                    Loaded="Card_Loaded" MouseLeftButtonDown="Card_MouseDown" MouseLeftButtonUp="Card_MouseUp"
                    MouseMove="Card_MouseMove" ContextMenuOpening="Card_ContextMenuOpening">
                <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                <StackPanel>
                    <!-- Immagine 16:9 -->
                    <Grid Height="{Binding DataContext.ThumbHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Rectangle RadiusX="7" RadiusY="7" Fill="Black" />
                        <Rectangle x:Name="Img" RadiusX="7" RadiusY="7" Opacity="{Binding Dim}">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding DisplayImage}" Stretch="{Binding ImageStretch}"
                                            RenderOptions.BitmapScalingMode="HighQuality" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="Gray"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ThumbFailed, Converter={StaticResource Vis}}" />

                        <!-- Durata (video) o formato (foto) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="5,1"
                                CornerRadius="4" Background="#B8000000"
                                Visibility="{Binding Badge, Converter={StaticResource NullVis}}">
                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>

                        <!-- Segnalibro: pieno se c'è un'etichetta, vuoto al passaggio del mouse -->
                        <Button x:Name="Ribbon" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" RenderTransformOrigin="0.5,0"
                                Cursor="Hand" Click="Ribbon_Click" ToolTip="{Binding RibbonTooltip}" Focusable="False"
                                Visibility="Collapsed" PreviewMouseRightButtonUp="Ribbon_RightClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="26" Height="36" Background="Transparent">
                                        <Path x:Name="Shape" Data="M0,0 L26,0 L26,36 L13,27.7 L0,36 Z"
                                              Fill="#66000000" Stroke="White" StrokeThickness="1.5" />
                                        <TextBlock x:Name="Glyph" Text="&#xE7C1;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Top" Margin="0,7,0,0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                            <Setter TargetName="Shape" Property="Fill" Value="{DynamicResource PickBrush}" />
                                            <Setter TargetName="Shape" Property="StrokeThickness" Value="0" />
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7C1;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                            <Setter TargetName="Shape" Property="Fill" Value="{DynamicResource RejectBrush}" />
                                            <Setter TargetName="Shape" Property="StrokeThickness" Value="0" />
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Cerchio di selezione (in alto a destra) -->
                        <Button x:Name="SelectCircle" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Cursor="Hand" Click="SelectCircle_Click" Focusable="False" Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="22" Height="22">
                                        <Ellipse x:Name="Circle" Fill="#40000000" Stroke="White" StrokeThickness="1.6" />
                                        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Circle" Property="StrokeThickness" Value="0" />
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Nome, ora, dimensione -->
                    <StackPanel Margin="3,6,3,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Opacity="{Binding Dim}" />
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="5,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{x:Static local:Strings.AlreadyImported}"
                                       Visibility="{Binding IsImported, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TimeSize}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="{Binding Dim}" />
                        <TextBlock Text="{Binding TechLabel}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Opacity="{Binding Dim}"
                                   Visibility="{Binding TechLabel, Converter={StaticResource NullVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    <Setter TargetName="Ribbon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SelectCircle" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding HasFlag}" Value="True">
                    <Setter TargetName="Ribbon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="SelectCircle" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Barra in alto ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="16,10" Visibility="{Binding HasSource, Converter={StaticResource Vis}}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="SourceIcon" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Text="&#xE88E;" />
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="260">
                    <Button x:Name="SourceButton" Style="{StaticResource LinkButton}" Padding="0" HorizontalAlignment="Left"
                            Click="SourceButton_Click" IsEnabled="{Binding NotImporting}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button.ContextMenu><ContextMenu /></Button.ContextMenu>
                    </Button>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button DockPanel.Dock="Left" x:Name="ChangeFolderButton" Style="{StaticResource PlainButton}" Margin="14,0,0,0" FontSize="12"
                        Click="ChangeFolder_Click" IsEnabled="{Binding NotImporting}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Left" x:Name="RefreshButton" Style="{StaticResource IconButton}" Margin="8,0,0,0" Content="&#xE72C;"
                        Click="Refresh_Click" IsEnabled="{Binding NotImporting}" VerticalAlignment="Center" />

                <!-- a destra -->
                <Button DockPanel.Dock="Right" x:Name="EjectButton" Style="{StaticResource IconButton}" Margin="10,0,0,0" Content="&#xF847;"
                        Click="Eject_Click" IsEnabled="{Binding NotImporting}" VerticalAlignment="Center"
                        Visibility="{Binding IsVolume, Converter={StaticResource Vis}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="SizePanel">
                    <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Slider Width="80" Minimum="150" Maximum="380" Value="{Binding ThumbSize}" Margin="6,0" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="SelectMenuButton" Style="{StaticResource PlainButton}" Margin="10,0,0,0" Click="SelectMenu_Click" VerticalAlignment="Center">
                    <Button.ContextMenu><ContextMenu /></Button.ContextMenu>
                </Button>
                <CheckBox DockPanel.Dock="Right" x:Name="HideImportedBox" Margin="12,0,0,0" IsChecked="{Binding HideImported}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" x:Name="SortButton" Style="{StaticResource PlainButton}" Margin="12,0,0,0" Click="Sort_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" />
                        <TextBlock Text="{Binding SortLabel}" />
                    </StackPanel>
                    <Button.ContextMenu><ContextMenu /></Button.ContextMenu>
                </Button>

                <!-- al centro: Tutto · Video · Foto -->
                <Border DockPanel.Dock="Left" Margin="24,0,0,0" Background="{DynamicResource SegmentBackBrush}" CornerRadius="7" VerticalAlignment="Center" x:Name="FilterBar">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" GroupName="filter" IsChecked="{Binding FilterAll}" />
                        <RadioButton x:Name="FilterVideos" Style="{StaticResource Segment}" GroupName="filter" IsChecked="{Binding FilterVideos}" />
                        <RadioButton x:Name="FilterPhotos" Style="{StaticResource Segment}" GroupName="filter" IsChecked="{Binding FilterPhotos}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===================== Contenuto ===================== -->
        <Grid Grid.Row="1">
            <!-- Benvenuto (nessuna scheda/cartella) -->
            <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding HasSource, Converter={StaticResource NotVis}}">
                <TextBlock Text="&#xE88E;" FontFamily="{StaticResource IconFont}" FontSize="64" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="WelcomeTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,8" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="WelcomeText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="WelcomeBrowse" Style="{StaticResource PlainButton}" Margin="0,16,0,0" HorizontalAlignment="Center" Click="ChangeFolder_Click" />
            </StackPanel>

            <Grid Visibility="{Binding HasSource, Converter={StaticResource Vis}}">
                <!-- Lettura in corso -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowScanning, Converter={StaticResource Vis}}">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" />
                    <TextBlock Text="{Binding ScanningText}" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <!-- Niente qui -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="44" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6" />
                    <TextBlock Text="{Binding EmptySubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="EmptyBrowse" Style="{StaticResource PlainButton}" Margin="0,14,0,0" HorizontalAlignment="Center" Click="ChangeFolder_Click" />
                </StackPanel>
                <!-- Solo foto / solo video -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowFilterEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="44" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding FilterEmptyTitle}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6" />
                    <TextBlock Text="{Binding FilterEmptySubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <Button x:Name="ShowAllButton" Style="{StaticResource PlainButton}" Margin="0,14,0,0" HorizontalAlignment="Center" Click="ShowAll_Click" />
                </StackPanel>
                <!-- Tutto importato -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowAllImported, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="44" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="AllImportedTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6" />
                    <TextBlock x:Name="AllImportedText" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- La griglia -->
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowGrid, Converter={StaticResource Vis}}"
                              Background="Transparent" MouseLeftButtonUp="EmptyArea_Click" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="16,12,2,4" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DaySection}">
                                <StackPanel>
                                    <Border Background="{DynamicResource HeaderBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,14,10"
                                            Visibility="{Binding HasHeader, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="12" Content="{Binding SelectDayLabel}" Click="SelectDay_Click" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Count}" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ClipTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Messaggio temporaneo -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="16,9" CornerRadius="18"
                    Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    Visibility="{Binding Banner, Converter={StaticResource NullVis}}" IsHitTestVisible="False">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" /></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource PickBrush}" FontSize="14" Margin="0,1,8,0" />
                    <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Barra in basso ===================== -->
        <Border Grid.Row="2" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="16,12" MinHeight="74" Visibility="{Binding HasSource, Converter={StaticResource Vis}}">
            <Grid>
                <!-- Opzioni -->
                <DockPanel Visibility="{Binding NotImporting, Converter={StaticResource Vis}}" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="ImportToLabel" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DestinationDisplay}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding DestinationPath}" />
                            <Button x:Name="ChangeDestButton" Style="{StaticResource PlainButton}" Padding="8,2" FontSize="12" Margin="8,0,0,0" Click="ChangeDest_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle DockPanel.Dock="Left" Width="1" Height="36" Fill="{DynamicResource DividerBrush}" Margin="16,0" />
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="OrganizeLabel" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox x:Name="FolderModeBox" MinWidth="230" SelectionChanged="FolderMode_Changed" />
                            <TextBox x:Name="CustomNameBox" Width="170" Margin="8,0,0,0" Padding="4,3" Text="{Binding CustomFolderName, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsCustomFolder, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DestinationPreview}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="ImportButton" Style="{StaticResource AccentButton}" Click="Import_Click" IsEnabled="{Binding CanImport}" ToolTip="{Binding ImportButtonTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ImportIcon" Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                                <TextBlock Text="{Binding ImportButtonTitle}" />
                            </StackPanel>
                        </Button>
                        <CheckBox Margin="0,6,0,0" HorizontalAlignment="Right" FontSize="11" IsChecked="{Binding DeleteAfter}"
                                  Content="{Binding DeleteAfterLabel}" ToolTip="{Binding DeleteAfterTooltip}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" x:Name="OptionsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Margin="0,0,14,0"
                            VerticalAlignment="Center" Click="Options_Click">
                        <Button.ContextMenu><ContextMenu /></Button.ContextMenu>
                    </Button>
                </DockPanel>

                <!-- Avanzamento -->
                <DockPanel Visibility="{Binding IsImporting, Converter={StaticResource Vis}}" VerticalAlignment="Center">
                    <Button DockPanel.Dock="Right" x:Name="CancelButton" Style="{StaticResource PlainButton}" Margin="16,0,0,0" Click="CancelImport_Click" VerticalAlignment="Center" />
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Progress.Detail}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Progress.Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Progress.Counter}" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                        <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress.Fraction, Mode=OneWay}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
